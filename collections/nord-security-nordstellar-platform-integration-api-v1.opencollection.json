        {
          "info": {
            "name": "Retrieves events for a specific project within a given date and time range.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://platform-integration-api.nordstellar.com/v1/projects/:project-id/events",
            "params": [
              {
                "name": "project-id",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the project"
              },
              {
                "name": "date-added-from",
                "value": "",
                "type": "query",
                "description": "Start datetime for filtering events (ISO 8601 format). Supported format: `YYYY-MM-DDTHH:MM:SS.000Z`"
              },
              {
                "name": "date-added-to",
                "value": "",
                "type": "query",
                "description": "End datetime for filtering events (ISO 8601 format). Supported format: `YYYY-MM-DDTHH:MM:SS.000Z`"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Numeric offset of the first element provided on a page representing a collection request"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Limit to restrict the number of entries on a page"
              }
            ]
          },
          "docs": "Retrieves events for a specific project within a given date and time range."
